script/source = "extends Label

onready var scene = $\"../..\"
onready var songTrackView = $\"../../SongViewContainer/SongTrackView\"

export var selection_start:float = 0 
export var selection_end:float = 0
# Called when the node enters the scene tree for the first time.
func _ready():
	yield(get_tree(), \"idle_frame\") 
	update_text()
	
func update_text():
	var selected_wrappers = songTrackView.get_selected_wrappers()
	if selected_wrappers.size() == 0:
		text = \"All the chord progression\\n\"
		var all_wrappers = songTrackView._wrappers
		var begin = all_wrappers[0].get_meta(\"start_time\")
		var end = all_wrappers[-1].get_meta(\"start_time\")
		end += all_wrappers[-1].get_meta(\"degree\").length_beats
		#text += \"from beat \"+ str(begin) + \" to beat \" + str(end)
		selection_start = begin
		selection_end = end
	else :
		text = \"\"
		var begin = selected_wrappers[0].get_meta(\"start_time\")
		var end = selected_wrappers[-1].get_meta(\"start_time\")
		end += selected_wrappers[-1].get_meta(\"degree\").length_beats
		text += \"from beat \"+ str(begin) + \" to beat \" + str(end)
		selection_start = begin
		selection_end = end
# Called every frame. 'delta' is the elapsed time since the previous frame.
#func _process(delta):
#	pass
"

