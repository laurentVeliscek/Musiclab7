script/source = "extends Button

const TAG = \"fractalize_button\"


const ALLOWED_TECHNIQUES = [\"passing_tone\", \"neighbor_tone\", \"neighbor_tone_forced\",\"appoggiatura\", \"chromatic_passing_tone\", \"chromatic_neighbor_tone\",\"double_neighbor\",\"escape_tone\",\"anticipation\",\"retardation\",\"extended_passing_tones\",\"pedal\"]
onready var songTrackView = $\"../../SongViewContainer/SongTrackView\"
onready var scene = $\"../..\"

var passe_number = 0

var results_array : Array = []


var rng:RandomNumberGenerator = RandomNumberGenerator.new()
var planner:Planner



# Called when the node enters the scene tree for the first time.
func _ready():
	
	LogBus.debug(TAG,\" _Planner new _\")
	planner = Planner.new()
	


func _on_fractalize_btn_pressed():
	passe_number += 1
	var txt_pass = \"round_\" + str(passe_number) +\"_\"
	
	scene.midi_player.stop()
	scene.rewind()
	rng.randomize()
	var _seed = rng.randi() % 1500000
	rng.seed = _seed
	scene.clear_console()
	
	var technique_weights:Dictionary = $\"../../techniques\".technique_weights()
	
	var params = {
		\"time_num\":scene.myMasterSong.time_num,
		\"time_den\":scene.myMasterSong.time_den,
		\"grid_unit\": $\"../../params/minimum_duration\".value
	}
	#LogBus.debug(TAG,str(params))
	
	var begin = $\"../selection_label\".selection_start
	var end = $\"../selection_label\".selection_end
	
	var region_size = end - begin
	
	if region_size <= 0:
		LogBus.info(TAG,'Click / Shift-Click the chords on the timeline to select a region to fractalize, or click \"select all\" to select the whole chord progression')
	
	var window_length = $\"../../params/Window_length\".value
	var nb_Windows = floor(region_size / $\"../../params/Window_length\".value) + 1
	#LogBus.debug(TAG, \" -> \" +str(nb_Windows))
	var time_windows = []
	var last_window = null
	for w in range(0,nb_Windows):
		var window = {\"start\": begin + (w * window_length), \"end\": begin + ((w+1) * window_length), \"iteration\":1}
		time_windows.append( window )
		last_window = window
	#LogBus.debug(TAG, str(time_windows))
	
	# on vire la derniere fenetre si elle son start > end

	time_windows[-1][\"end\"] = min(end,time_windows[-1][\"end\"])
	#LogBus.debug(TAG, str(time_windows))	
	if time_windows[-1][\"start\"] == end :
		var poubelle = 	time_windows.pop_back()
	#LogBus.debug(TAG, str(time_windows))	
	
	params[\"time_windows\"] = time_windows
	params[\"allowed_techniques\"] = ALLOWED_TECHNIQUES
	params[\"technique_weights\" ] = technique_weights
	
	params[\"voice_window_pattern\"] = $\"../../params/voice_pattern\".text
	params[\"pair_selection_strategy\"] = $\"../../params/strategy\".text.to_lower()
	params[\"triplet_allowed\"] = $\"../../params/Triolet\".value
	params[\"rng_seed\"] = rng.randi() % 150000
	#scene.clear_console()
	
	_save_text_to_disk(JSON.print(params),txt_pass + \"params.txt\")
	var chords = scene.results_history_array[scene.results_history_array.size() - 1].chords
	_save_text_to_disk(JSON.print(chords),txt_pass + \"chords.txt\")
	  
	scene.clear_console()
	
	var result = planner.apply(chords, params)	
	var debug_txt = scene.console.text
	_save_text_to_disk(JSON.print(result),txt_pass + \"debug.txt\")
	_save_text_to_disk(JSON.print(result),txt_pass + \"result.txt\")
	
	scene.results_history_array.append(result)
#	var new_track = 
	var last_end = 0
	var txt  = \"\"
	for c in result.chords:
		txt += \"gap: \" + str(last_end - c[\"pos\"])+  \" |  pos: \" + str(c[\"pos\"]) + \"  | length: \" + str(c[\"length_beats\"]) + \"\\n\"
		
		
		last_end = c[\"pos\"] + c[\"length_beats\"]
		
	_save_text_to_disk(txt,txt_pass + \"pos.txt\")
	
	
	scene.myMasterSong.remove_track_by_name(Song.FRACTAL_TRACK)
	scene.myMasterSong.add_track(scene.result_to_track(result))
	scene.myPlayingSong.remove_track_by_name(Song.FRACTAL_TRACK)
	scene.myPlayingSong.add_track(scene.myMasterSong.get_track_by_name(Song.FRACTAL_TRACK))
	
	songTrackView._update_all()
	
	#LogBus.debug(TAG,scene.myPlayingSong.get_track_by_name(Song.FRACTAL_TRACK).to_string())
	
	
#	scene.clear_console()
#	LogBus.debug(TAG,JSON.print(result,\"\\t\"))
#	# on ajoute result à results_history_array
#	scene.results_history_array.append(result)
#	# on dépiote results...
#	LogBus.info(TAG, \"\\n===== Bilan =====\")
#	LogBus.info(TAG, \"\\n===== PASS 1 =====\")
#	LogBus.info(TAG, \"Total chords: \" + str(result.chords.size()))
#
##
##	# AFFICHAGE NEW SATB
#	LogBus.info(TAG,\"\\n\\n********** SUCCESS ************\")
#	for c in result.chords:
#		if c[\"kind\"] == \"decorative\":
#			#LogBus.info(TAG, JSON.print(c, \"\\t\"))
#			var comment = c[\"chord_metadata\"][\"comments\"]
#
#			LogBus.info(TAG,comment)
#			var pos = c[\"pos\"]
#			LogBus.info(TAG,str(pos))
	# AFFICHAGE CHORDS PASS 2
#	LogBus.info(TAG, \"\\n\\nResult (full): \" + JSON.print(result.chords, \"\\t\"))

#
#	# AFFICHAGE ECHECS
#	LogBus.info(TAG,\"\\n====== HISTORY FAILED ========\")
#	var meta = result[\"metadata\"]
#	var history = meta[\"history\"]
#	for h in history:
#		if h[\"status\"] == \"skipped\":
#			LogBus.info(TAG,str(h))
#
	#func result_to_track(r:Dictionary)->Track:
	
	
#	LogBus.debug(TAG, \"============ PARAMS ============\")
#	LogBus.debug(TAG,JSON.print(params,\"\\t\"))
#	LogBus.debug(TAG, \"============ CHORDS ============\")
#	var chords = setup_SATB(chords_generations[-1])
#	LogBus.debug(TAG,JSON.print(chords,\"\\t\"))
	

	
	#LogBus.debug(TAG,\"chords_generations.size(): \" + str(chords_generations.size()))
	
#	var result = planner.apply(chords_generations[0], params)	
#	scene.clear_console()
#	LogBus.debug(TAG,JSON.print(result,\"\\t\"))
#	return
#
#	chords_generations.append(result)
#	var track:Track = result_to_track(result)
#	track.name = Song.FRACTAL_TRACK
#	scene.myMasterSong.remove_track_by_name(Song.FRACTAL_TRACK)
#	scene.myMasterSong.add_track(track)
#
#	scene.songTrackView.trackName = Song.FRACTAL_TRACK
#	scene.songTrackView._update_all()
	
	#scene.clear_console()	
	#LogBus.debug(TAG,JSON.print(result,\"\\t\"))
		
		
		
	


func _save_text_to_disk(content: String, filename: String) -> void:
	# Écrit dans user:// (persistance locale; en HTML5 = IndexedDB)
	var path = \"user://\" + filename
	var f = File.new()
	var err = f.open(path, File.WRITE)
	if err == OK:
		f.store_string(content)
		f.close()
	
"

