	scene.midi_player.stop()
	var song:Song = scene.myMasterSong
	song.tempo_bpm = value
	$\"../../Pattern\"._update_pattern_display()
	
#	if song != null:
#		scene.midi_player.stop()
#		song.tempo_bpm = value
