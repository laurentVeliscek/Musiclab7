script/source = "extends Control

var TAG = \"Pattern\"

# index du StrumPattern courant
var current:int = 0 
var preview_guitar_player: FolkGuitarPlayer
var preview_playing = false


onready var step_beat_length_btn:Button = $step_beat_length_btn
onready var pattern_number_sb:SpinBox = $pattern_number_sb
onready var scene = $\"..\"
onready var delete_btn = $delete_btn
onready var info_pattern_label:Label = $info_pattern_label
onready var pattern = $\".\"
# Called when the node enters the scene tree for the first time.
func _ready():
	preview_guitar_player = FolkGuitarPlayer.new()
	


func _update_pattern_display():
	
	var currentStrumPattern:StrumPattern = scene.gp.pattern_sequence[current]
	pattern_number_sb.value = current + 1
	step_beat_length_btn.step_length = currentStrumPattern.step_beat_length
	$pattern_lineEdit.text = currentStrumPattern.pattern.rstrip(\" \")
	scene.set_player_config(currentStrumPattern)
	var info_txt = str(scene.gp.pattern_sequence.size())

	info_pattern_label.text = info_txt

func _on_delete_btn_pressed():
	var seq = scene.gp.pattern_sequence
	if seq.size() > 1:
		seq.remove(current)
		$pattern_number_sb._on_pattern_number_sb_value_changed(current) 
		if seq.size() == 1:
			delete_btn.hide()
		
	
	_update_pattern_display()
	
	$\"..\".clear_console()
	$\"..\".rewind()
	LogBus.info(TAG,\"Pattern deleted\")
	

func _on_generate_btn_pressed():
	scene.rewind()
	var generator = GuitarPatternGenerator.new()
	var style = \"\"
	match $pattern_style_ob.selected :
		0: style = \"Folk\"
		1: style = \"Funky\"
		2: style = \"R'n B\"
		3: style = \"Bossa\"
		4: style = \"random\"
		5: style = \"random_no_gap\"
		6: style = \"random_melody\"
		7: style = \"brassens\"
		8: style = \"arpeggio1\"
		9: style = \"arpeggio2\"
		10: style = \"ska\"
		11: style = \"reggae\"
		12: style = \"shame_shame\"
		13: style = \"torn\"
		14: style = \"london_calling\"
		15: style = \"playa\"


		
	var answer = generator.generate(style)
	var currentStrumPattern:StrumPattern = scene.gp.pattern_sequence[current]
	currentStrumPattern.pattern = answer[\"pattern\"]
	currentStrumPattern.step_beat_length = answer[\"step_beat_length\"] * 2
	
	
	_update_pattern_display()
	scene.rewind()
	play_preview()
	LogBus.info(TAG,style +\" Pattern generated\")

func _on_pattern_style_ob_item_selected(index):
	yield(get_tree(), \"idle_frame\") 
	_on_generate_btn_pressed()
	
func convert_to_minutes_seconds(number_of_seconds: float) -> Dictionary:
	var minutes = int(number_of_seconds / 60)
	var seconds = int(number_of_seconds) % 60
	return {\"minutes\": minutes, \"seconds\": seconds}


func _on_preview_btn_pressed():
	play_preview()
	
func play_preview():
	if preview_playing:
		scene.midi_player.stop()
		scene.playStopBtn.text = \"Play\"
		return
	scene.midi_player.stop()
	
	#On récupère la valeur de transpose
	var transpose = $\"../octave/HBoxContainer/octave_offset_vs\".value * 12
	var sp:StrumPattern = scene.gp.pattern_sequence[current].clone()
	var gc:GuitarChord = $\"../voicingContainer/voicing_view\".get_current_guitar_chord().clone()
	var step = sp.step_beat_length
	var pattern_length = 16 * step
	gc.length_beats = pattern_length
	preview_guitar_player.chord_grid = [gc]
	preview_guitar_player.pattern_sequence = [sp]
	var guitar_track:Track = preview_guitar_player.generate_track(transpose)
	
	# on récupère les settings midi

	var num_program_change = int($\"../instruments/guitar_program_ob\".selected)
	var volume = int($\"../Volume/Volumes/guitar_volume/Guitar_volume_VS\".value)
	
	
	
	var pc:ProgramChange = ProgramChange.new()
	pc.set_program(num_program_change)
	guitar_track.program_change = pc
	var volume_midi_cc:MidiCC = MidiCC.new()
	volume_midi_cc.set_controller(7)
	volume_midi_cc.set_value(volume)
	guitar_track.add_midiCC(0,volume_midi_cc)
	
	var previewSong = Song.new()
	previewSong.tempo_bpm = scene.myMasterSong.tempo_bpm
	previewSong.time_num = scene.myMasterSong.time_num
	previewSong.time_den = scene.myMasterSong.time_den
	previewSong.add_track(guitar_track)
	scene.anim_songTrack_view = false
	var bytes = previewSong.get_midi_bytes_type1()
	scene.midi_player.load_from_bytes(bytes)
	scene.playStopBtn.text = \"Stop\"

	preview_playing = true
	scene.song_playing_ended = false
	scene.clear_console()
	$preview_btn.text = \"Stop\"
	LogBus.info(TAG,\"Playing preview...\")
	scene.midi_player.play()
	


func _on_variation_btn_pressed():
	scene.midi_player.stop()
	yield(get_tree(), \"idle_frame\") 
	var patternLineEdit = $pattern_lineEdit
	var monTexte = patternLineEdit.text
	var allowed = \" .DdUu01234xXBbFf\"
	var random_pos = randi() % 16
	var _char = monTexte[random_pos]
	
	var is_the_same:bool = true
	while is_the_same:
		var new_char = allowed[randi() % allowed.length()]
		if new_char != _char:
			monTexte = change_char(monTexte, random_pos, new_char)
			is_the_same = false
		
	patternLineEdit.text = monTexte
	patternLineEdit._on_text_changed(monTexte)
	_update_pattern_display()
	scene.rewind()
	play_preview()
	LogBus.info(TAG,\"Variation generated\")
	
func change_char(s: String, pos: int, new_char: String) -> String:
	# Vérifie que la position est valide
	if pos < 0 or pos >= s.length():
		return s  # Retourne la chaîne inchangée si la position est invalide

	# Construit la nouvelle chaîne en remplaçant le caractère à la position 'pos'
	return s.substr(0, pos) + new_char + s.substr(pos + 1)
"

